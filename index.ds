// Host-granted fs.
//
// Return types are declared explicitly. `bridge` is the FFI boundary and the
// compiler cannot see through it, so an un-annotated export leaves callers
// holding `Result<<infer>, <infer>>` -- which then fails at the match site
// with "`Ok` is not a case of type `<infer>`" (deka#502).
//
// Bind byte results with `let`, not `const`.
// Catalog: read_file, write_file, read_dir, mkdirs. No stat/remove yet.
//
// These are asynchronous host ops (`op_php_fs_call_proto` is `#[op2(async)]`),
// so the post-deka#584 surface is `async fn` plus `await bridge`, declared as
// `Promise<Result<T, E>>`.
//
// Grants: `read_file` and `read_dir` need `security.allow.read`; `write_file`
// and `mkdirs` need `security.allow.write`. The keys are `read` and `write` --
// there is no `fs` capability key.

interface DirEntry {
  name: string
  is_dir: boolean
  is_file: boolean
}

export async fn read_file(path: string) Promise<Result<bytes, string>> {
  return await bridge fs.read_file(path)
}

export async fn write_file(path: string, data: bytes) Promise<Result<number, string>> {
  return await bridge fs.write_file(path, data)
}

export async fn read_dir(path: string) Promise<Result<Array<DirEntry>, string>> {
  return await bridge fs.read_dir(path)
}

export async fn mkdirs(path: string) Promise<Result<boolean, string>> {
  return await bridge fs.mkdirs(path)
}
