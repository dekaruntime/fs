// Host-granted filesystem operations.
//
// The package is deliberately thin: the host grant permits these `bridge fs.*`
// calls, and the host checks phase-aware, target-scoped permissions. There is
// no package policy or fallback path. File data is always `bytes`; this module
// never decodes it. Callers that need text must explicitly use @deka/bytes and
// handle its strict UTF-8 failure value.
//
// The async operations yield while the host performs IO. Their `_sync` twins
// are genuinely blocking host operations for startup and script work; they are
// not Promises wrapped in a synchronous-looking API.

interface DirEntry {
  name: string
  is_dir: boolean
  is_file: boolean
}

struct FsPermission {
  capability: string
  target: string
}

// Every public operation returns this enum, never a string error. The host
// materializes these values at the bridge boundary so callers can distinguish
// denied IO from a missing native filesystem without inspecting messages.
enum FsError {
  PermissionDenied(FsPermission),
  UnsupportedHost,
  InvalidPayload,
  Failed(string),
}

export { FsPermission, FsError }

export async fn read_file(path: string) Promise<Result<bytes, FsError>> {
  return await bridge fs.read_file(path)
}

export fn read_file_sync(path: string) Result<bytes, FsError> {
  return bridge fs.read_file_sync(path)
}

export async fn write_file(path: string, data: bytes) Promise<Result<number, FsError>> {
  return await bridge fs.write_file(path, data)
}

export fn write_file_sync(path: string, data: bytes) Result<number, FsError> {
  return bridge fs.write_file_sync(path, data)
}

export async fn read_dir(path: string) Promise<Result<Array<DirEntry>, FsError>> {
  return await bridge fs.read_dir(path)
}

export fn read_dir_sync(path: string) Result<Array<DirEntry>, FsError> {
  return bridge fs.read_dir_sync(path)
}

export async fn mkdirs(path: string) Promise<Result<boolean, FsError>> {
  return await bridge fs.mkdirs(path)
}

export fn mkdirs_sync(path: string) Result<boolean, FsError> {
  return bridge fs.mkdirs_sync(path)
}
