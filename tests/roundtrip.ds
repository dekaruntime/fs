import { read_file } from "../index.ds"

fn from_utf8(value: bytes): string {
  let decoded = unsafe { new TextDecoder("utf-8", { fatal: false }).decode(value) };
  return match (decoded) {
    Ok(text) => text,
    Err(err) => ""
  };
}

async fn go() {
  let got = await read_file("tests/hello.txt");
  const text = match (got) {
    Ok(buf) => from_utf8(buf),
    Err(e) => "fail-read"
  };
  if (text != "hello fs\n") {
    print("fail-read");
    print(text);
    return;
  }

  const missing = await read_file("tests/does-not-exist.txt");
  const missing_err = match (missing) {
    Ok(v) => false,
    Err(e) => true
  };
  if (!missing_err) {
    print("fail-missing");
    return;
  }

  print("ok");
}

go()
